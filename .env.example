# ===================== DATABASE (Free Tier via Neon: neon.tech) =====================
# Get your free serverless Postgres connection string from https://neon.tech
# Neon provides a free tier with pgvector pre-installed (0.5GB storage, $0/mo).
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://username:password@your-neon-hostname.aws.neon.tech/neondb?sslmode=require

# ===================== AUTH =====================
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ===================== DEFAULT ADMIN (auto-created on first startup, optional) =====================
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123

# ===================== OPEN SOURCE LLM (100% Free via Groq) =====================
# Get a free API key at https://console.groq.com ($0/mo, fast open-source inference)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# ===================== EMBEDDINGS & RERANKER (Local, runs in-memory at $0 cost) =====================
# State-of-the-art open source models (run locally on CPU, no API key needed):
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANK_MODEL=BAAI/bge-reranker-base

# ===================== APP & CORS CONFIGURATION =====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
TOP_K_CHUNKS=6

# Set to your Vercel or Netlify frontend URL(s) in production, e.g.:
# ALLOWED_ORIGINS=https://your-rag-app.vercel.app,https://your-rag-app.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=*
